# Configuración de Supabase para LaburamosApp.
# Copiá este archivo como `.env` en la raíz del proyecto (al lado de package.json)
# y completá los valores del Supabase NUEVO (no uses la base de Workeo).
# En StackBlitz, creá el `.env` desde el explorador de archivos y recargá.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# Dirección pública del sitio (opcional en local). Define el canonical, og:url,
# sitemap.xml y robots.txt. En producción se configura en cada host.
# Ejemplo: VITE_SITE_URL=https://laburamosapp.pages.dev
VITE_SITE_URL=https://laburamosapp.netlify.app

