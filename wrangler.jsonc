// Configuración para Cloudflare Workers (assets estáticos).
// El proyecto "laburamosapp" del panel de Cloudflare publica con `npx wrangler deploy`.
// El sitio es un SPA: cualquier ruta que no sea un archivo existente devuelve index.html.
{
  "name": "laburamosapp",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
